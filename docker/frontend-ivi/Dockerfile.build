# Multi-stage Dockerfile for local testing / self-contained builds.
# Builds ivi-homescreen + Flutter app + packages everything.
#
# Usage from project root:
#   docker build -f docker/frontend-ivi/Dockerfile.build -t centroid-hmi-ivi .
#   docker build -f docker/frontend-ivi/Dockerfile.build --build-arg BUILD_MODE=release -t centroid-hmi-ivi .

# =============================================================================
# Stage 1: Build ivi-homescreen embedder from source
# =============================================================================
FROM debian:trixie-slim AS homescreen-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git pkg-config ca-certificates \
    libwayland-dev wayland-protocols \
    libvulkan-dev \
    libegl1-mesa-dev libgles2-mesa-dev \
    libxkbcommon-dev \
    libglib2.0-dev \
    && rm -rf /var/lib/apt/lists/*

# af71d2d carries the multi-seat touch fix (centroid-is/ivi-homescreen#2):
# without it, weston's screen-share VNC seat releases the touchscreen's
# wl_touch handle and all touch input dies.
ARG IVI_HOMESCREEN_REF=af71d2d
RUN git clone --recurse-submodules -j8 \
    https://github.com/centroid-is/ivi-homescreen.git \
    /src/ivi-homescreen \
    && cd /src/ivi-homescreen && git checkout ${IVI_HOMESCREEN_REF}

WORKDIR /src/ivi-homescreen/build
RUN WAYLAND_PROTOCOLS_DIR=$(pkg-config --variable=pkgdatadir wayland-protocols) \
    && cmake .. \
    -DCMAKE_STAGING_PREFIX=/opt/homescreen \
    -DCMAKE_INSTALL_PREFIX=/opt/homescreen \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_BACKEND_WAYLAND_EGL=OFF \
    -DBUILD_BACKEND_WAYLAND_VULKAN=ON \
    -DENABLE_XDG_CLIENT=ON \
    -DENABLE_AGL_CLIENT=OFF \
    -DENABLE_IVI_SHELL_CLIENT=OFF \
    -DENABLE_DLT=OFF \
    -DBUILD_UNIT_TESTS=OFF \
    -DBUILD_DOCS=OFF \
    -DEXT_PROTOCOL="${WAYLAND_PROTOCOLS_DIR}/unstable/text-input/text-input-unstable-v1.xml" \
    && make install -j$(nproc)

# =============================================================================
# Stage 2: Build Flutter app (native assets + AOT + assets)
# =============================================================================
FROM debian:trixie-slim AS flutter-builder

ENV DEBIAN_FRONTEND=noninteractive

# libmpv-dev: media_kit_video's GTK plugin links against it (RTSP camera
# asset). The runtime image deliberately does not ship libmpv — ivi-homescreen
# has no GTK plugin registrar, so camera tiles degrade to their placeholder on
# these stations either way.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git unzip xz-utils zip ca-certificates \
    clang llvm lld cmake ninja-build pkg-config \
    build-essential python3 \
    libgtk-3-dev liblzma-dev libstdc++-14-dev \
    libsecret-1-dev libmpv-dev \
    libnss3 libnspr4 libasound2t64 \
    && rm -rf /var/lib/apt/lists/*

# libnss3 / libnspr4 / libasound2t64: CEF's libcef.so names ALSA and NSS in
# its DT_NEEDED, so `flutter build linux` cannot link the Web page asset's
# plugin (packages/webview_cef) without them, even though nothing of ours
# calls either. libasound2t64, not libasound2 — trixie's t64 transition
# renamed it and the old name does not resolve.

# Install Flutter SDK (pinned to ensure engine hash matches ardera/flutter-ci releases)
ARG FLUTTER_VERSION=3.38.7
RUN git clone https://github.com/flutter/flutter.git /opt/flutter \
    --depth 1 --branch ${FLUTTER_VERSION}
ENV PATH="/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:${PATH}"
RUN flutter precache --linux

# Copy project source (root is the 'tfc' package, centroid-hmi depends on it via path: ../)
WORKDIR /app
COPY pubspec.yaml ./
COPY lib/ ./lib/
COPY assets/ ./assets/
COPY packages/ ./packages/
COPY centroid-hmi/ ./centroid-hmi/

WORKDIR /app/centroid-hmi

RUN flutter pub get

# Build for Linux desktop - this compiles:
#   - Dart assets (flutter_assets/)
#   - AOT library (libapp.so, release only)
#   - Native FFI assets (open62541, etc.)
#   - Flutter engine (libflutter_engine.so)
ARG BUILD_MODE=debug
# CENTROIDX_CHAT/CENTROIDX_KNOWLEDGE off: the shipped image excludes the AI chat and
# knowledge features for now (lib/core/feature_flags.dart).
RUN flutter build linux --${BUILD_MODE} --dart-define=CENTROIDX_CHAT=false --dart-define=CENTROIDX_KNOWLEDGE=false

# Assemble the ivi-homescreen bundle from the Linux build output
RUN BUILD_DIR=$(find build/linux -path "*/${BUILD_MODE}/bundle" -type d | head -1) \
    && echo "=== Flutter build output ===" \
    && find "${BUILD_DIR}" -type f | sort \
    && mkdir -p /bundle/data /bundle/lib \
    && for f in "${BUILD_DIR}"/lib/*.so; do \
         name=$(basename "$f"); \
         case "$name" in \
           libflutter_linux_gtk.so) ;; \
           *) cp "$f" /bundle/lib/ ;; \
         esac; \
       done \
    && cp -r "${BUILD_DIR}/data/"* /bundle/data/ \
    && echo "=== ivi-homescreen bundle ===" \
    && find /bundle -type f | sort

# Download standalone libflutter_engine.so from ardera/flutter-ci
# (Google only ships debug standalone engines; ardera builds all modes from source)
RUN ENGINE_HASH=$(cat /opt/flutter/bin/internal/engine.version) \
    && ARCH=$(dpkg-architecture -qDEB_HOST_ARCH) \
    && case "$ARCH" in \
         amd64) ENGINE_ARCH="x64" ;; \
         arm64) ENGINE_ARCH="aarch64" ;; \
         *) echo "Unsupported arch: $ARCH"; exit 1 ;; \
       esac \
    && echo "Downloading Flutter engine ${ENGINE_HASH} (${BUILD_MODE}) for ${ENGINE_ARCH}..." \
    && curl -sL "https://github.com/ardera/flutter-ci/releases/download/engine%2F${ENGINE_HASH}/engine-${ENGINE_ARCH}-generic-${BUILD_MODE}.tar.xz" \
       -o /tmp/engine.tar.xz \
    && tar -xJf /tmp/engine.tar.xz -C /bundle/lib/ \
    && rm /tmp/engine.tar.xz \
    && ls -la /bundle/lib/libflutter_engine.so

# =============================================================================
# Stage 3: Runtime
# =============================================================================
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libstdc++6 \
    libgcc-s1 \
    libc6 \
    libfontconfig1 \
    libxkbcommon0 \
    libwayland-client0 \
    libwayland-cursor0 \
    libvulkan1 \
    mesa-vulkan-drivers \
    libfreetype6 \
    libexpat1 \
    libffi8 \
    zlib1g \
    libpng16-16 \
    libglib2.0-0 \
    libsecret-1-0 \
    sqlite3 \
    dpkg-dev \
    libnss3 \
    libnspr4 \
    libasound2t64 \
    libatk1.0-0t64 \
    libatk-bridge2.0-0t64 \
    libatspi2.0-0t64 \
    libcups2t64 \
    libxcomposite1 \
    libxdamage1 \
    && rm -rf /var/lib/apt/lists/*

# libnss3 through libxdamage1 are CEF's runtime dependencies, for the Web page
# asset's browser. CEF itself is not installed here — the plugin's CMake
# downloads it at build time and it ships in the bundle — but libcef.so names
# every one of them in its DT_NEEDED, so missing any one stops the whole app
# from loading, not just the browser. The ldd check at the end of this stage
# fails the build instead.

# Hacks for amplify secure storage (arch-agnostic)
RUN LIBDIR=$(dpkg-architecture -qDEB_HOST_MULTIARCH) \
    && ln -sf /usr/lib/${LIBDIR}/libgio-2.0.so.0 /usr/lib/${LIBDIR}/libgio-2.0.so \
    && ln -sf /usr/lib/${LIBDIR}/libglib-2.0.so.0 /usr/lib/${LIBDIR}/libglib-2.0.so \
    && ln -sf /usr/lib/${LIBDIR}/libsecret-1.so.0 /usr/lib/${LIBDIR}/libsecret-1.so

RUN useradd -m centroid

ARG APP_DIR=/flutter-app
WORKDIR $APP_DIR

# Copy ivi-homescreen binary from stage 1
COPY --from=homescreen-builder /opt/homescreen/bin/homescreen ./

# Copy assembled Flutter bundle from stage 2
COPY --from=flutter-builder /bundle/ ./bundle/

# Symlink so package_info_plus can find version.json
# (it looks relative to the executable, not the bundle path)
RUN ln -s bundle/data data

# Symlink so FFI plugins (pdfium_flutter, etc.) can resolve their .so files
# (pdfrx loads libpdfium.so relative to the app dir, not the bundle dir)
RUN ln -s bundle/lib lib

RUN chown -R centroid:centroid $APP_DIR \
    && chmod +x ./homescreen

# Fail the build, not the station: every library the binary or the bundle
# names must resolve in this image. A bundled plugin that pulls in a new
# system library otherwise ships an image that cannot start.
RUN missing=$(for f in ./homescreen bundle/lib/*.so; do \
        LD_LIBRARY_PATH=./bundle/lib ldd "$f" | grep 'not found' | sed "s|^[[:space:]]*|$f: |"; \
    done); \
    if [ -n "$missing" ]; then \
        echo "Unresolved shared libraries; install the packages that provide them:"; \
        echo "$missing"; \
        exit 1; \
    fi

USER centroid

CMD ["/bin/sh", "-c", "LD_LIBRARY_PATH=./bundle/lib ./homescreen -b ./bundle -f"]

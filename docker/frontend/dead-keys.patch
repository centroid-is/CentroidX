+// Resolves a key press through the compose state. Must be called once per
+// press and never for a release: every call advances the sequence.
+//
+//   dead_acute         -> 0, nothing typed yet
+//   dead_acute, a      -> U+00E1
+//   dead_acute, k      -> U+006B; the sequence is dropped but the letter
+//                         still types, which reads better on a panel than
+//                         GTK's losing both
+//
+// Keysyms that take no part in composing, modifiers among them, are ignored by
+// the compose state and come back as their plain code point.
+uint32_t KeyeventPlugin::ComposeCodePoint(uint32_t keycode) {
+  auto sym = xkb_state_key_get_one_sym(xkb_state_, keycode + 8);
+  if (!xkb_compose_state_ ||
+      xkb_compose_state_feed(xkb_compose_state_, sym) !=
+          XKB_COMPOSE_FEED_ACCEPTED) {
+    return xkb_keysym_to_utf32(sym);
+  }
+  switch (xkb_compose_state_get_status(xkb_compose_state_)) {
+    case XKB_COMPOSE_COMPOSING:
+      return 0;
+    case XKB_COMPOSE_COMPOSED: {
+      auto composed = xkb_compose_state_get_one_sym(xkb_compose_state_);
+      xkb_compose_state_reset(xkb_compose_state_);
+      return xkb_keysym_to_utf32(composed);
+    }
+    case XKB_COMPOSE_CANCELLED:
+      xkb_compose_state_reset(xkb_compose_state_);
+      return xkb_keysym_to_utf32(sym);
+    case XKB_COMPOSE_NOTHING:
+    default:
+      return xkb_keysym_to_utf32(sym);
+  }

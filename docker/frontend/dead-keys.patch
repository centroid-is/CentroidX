+  if (!xkb_compose_table_) {
+    ELINUX_LOG(WARNING)
+        << "No Compose table found; dead keys will not type accented letters";
+    return;
+  }
+  xkb_compose_state_ =
+      xkb_compose_state_new(xkb_compose_table_, XKB_COMPOSE_STATE_NO_FLAGS);
+}

+// one every Latin locale's table includes, so the fallback covers the dead
+// keys of every layout the stations offer. The table itself comes from
+// libx11-data; without it composing is off and keys behave as before.
+void KeyeventPlugin::CreateComposeState() {
+  const char* locale = nullptr;
+  for (const char* name : {"LC_ALL", "LC_CTYPE", "LANG"}) {
+    const char* value = getenv(name);
+    if (value && *value) {

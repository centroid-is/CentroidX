# Per-station configuration for docker-compose.yml. Copy to `.env` beside the
# compose file -- compose reads it automatically, and it is gitignored.
#
# On a station installed from os/ (the image builder), centroidx-firstboot
# writes this file for you and you should never edit it by hand. These notes are
# for an existing station, or for a bench machine set up without the installer.

# ---------------------------------------------------------------------------
# READ FROM THE HOST. Never type these. They are properties of the machine
# Debian ended up on, not choices.
# ---------------------------------------------------------------------------

# The group that owns /dev/dri/renderD128. Get it with:
#   stat -c %g /dev/dri/renderD128
#
# This one has no safe default and no fallback worth having. Before it was
# wired up, the compose file hardcoded 992, which matched no group on any
# station -- so mesa could not open the render node, fell back to the llvmpipe
# software rasteriser, and burned ~12 threads at most of a core each with
# nothing logged anywhere. Fixing it measured 150% -> 25% CPU on one station and
# 112% -> 36% on another. The compose file now refuses to start without it.
RENDER_GID=

# The group that owns /var/run/docker.sock. Get it with:
#   stat -c %g /var/run/docker.sock
#
# Wrong value costs you the docker-update UI and the profiler's Containers
# section. The docker-update-state one-shot checks it at boot and fails with the
# exact fix command, which is why this one keeps a default instead of refusing
# to start -- its error message is better than compose's would be.
DOCKER_GID=1001

# ---------------------------------------------------------------------------
# SET AT INSTALL TIME. The USB installer prompts for these.
# ---------------------------------------------------------------------------

# Names the station in the browser tab: "CentroidX - Frystar". One noVNC image
# serves every station, so this is the only thing that distinguishes them.
NOVNC_STATION_NAME=

# Password for the database. Used by timescaledb, centroidx-backend and the
# profiler, so all three must agree -- which is why it is one variable.
#
# NOTE on an existing station: timescaledb only reads POSTGRES_PASSWORD when it
# initialises an empty data directory. Setting this on a station that already
# has ./timescale_data does NOT change the database password; rotate it with
#   docker compose exec timescaledb psql -U centroid -d hmi \
#     -c "ALTER ROLE centroid PASSWORD '...'"
# and put the same value here.
DB_PASSWORD=

# Password for the remote screen. This is what a VNC client or the noVNC page
# asks for -- it is set on the `centroid` user inside the weston container and
# has nothing to do with the host login of the same name.
VNC_PASSWORD=

# ---------------------------------------------------------------------------
# GENERATED. No human needs to know these; the installer makes them up.
# ---------------------------------------------------------------------------

# Unlocks the HMI's local keyring file (flutter_secure_storage with
# SECRET_BACKEND=file). Local to the station, never transmitted.
#   openssl rand -base64 24
#
# ON AN EXISTING STATION this must be the old literal,
# TODOSetThisStrongPassword -- the keyring file on disk is encrypted with it.
# A fresh value does not re-key the file, it orphans it: the stored database
# config, the dbus login and every secure preference become unreadable. Rotate
# it only together with deleting local-share/keyrings/flutter.keyring and
# re-entering what was in it.
FLUTTER_KEYRING_PASSWORD=

# Basic auth on the docker-update UI (port 8443). Guards every route except
# /healthz.
DOCKER_UPDATE_BASIC_AUTH_USER=centroid
DOCKER_UPDATE_BASIC_AUTH_PASS=

# CN and subjectAltName on docker-update's self-signed certificate. Usually the
# same as NOVNC_STATION_NAME.
DOCKER_UPDATE_CERT_CN=

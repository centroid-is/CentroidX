#!/bin/bash
# CentroidX station installer. Runs on tty1 of the USB key.
#
# It does not install Debian -- it writes an already-installed Debian onto the
# SSD. Everything the old firstboot-install.sh did over the plant uplink
# (debootstrap, 25 apt packages, an ansible run) happened in CI instead.
set -uo pipefail

PAYLOAD=/opt/centroidx
SEED="$PAYLOAD/station.env"
TARGET_MNT=/mnt/target

# Declared up front: a station.env that omits one of these would otherwise trip
# `set -u` much later, after the disk has already been written.
TARGET=""
BOOT_DISK=""
UNATTENDED=0
STATION_NAME=""
CENTROID_PASSWORD=""
ROOT_PASSWORD=""
VNC_PASSWORD=""
DB_PASSWORD=""

red()  { printf '\033[1;31m%s\033[0m\n' "$*"; }
grn()  { printf '\033[1;32m%s\033[0m\n' "$*"; }
bold() { printf '\033[1m%s\033[0m\n' "$*"; }
rule() { printf '%s\n' "------------------------------------------------------------"; }

# Both on stderr: die is called from inside $(...) in places, and anything it
# wrote to stdout there would be captured as data instead of shown. (Review #1:
# the refusal text became the sole "install candidate".)
die() { printf '\033[1;31m%s\033[0m\n' "  FAILED: $*" >&2; exit 1; }

banner() {
  clear 2>/dev/null || true
  bold "  CentroidX station installer"
  [ -r "$PAYLOAD/image-info" ] && sed 's/^/  /' "$PAYLOAD/image-info"
  rule
}

# ---------------------------------------------------------------- target disk
# The USB we booted from must never appear in this list.
boot_disk() { lsblk -no PKNAME "$(findmnt -no SOURCE /)" 2>/dev/null | head -1; }

# $BOOT_DISK is resolved in main() before this is ever called. Do NOT try to
# resolve it here: candidates() runs inside a command substitution, so a die()
# from this depth would exit only the subshell and the caller would carry on
# with the error message as its data.
candidates() {
  lsblk -dno NAME,SIZE,MODEL --sort NAME | while read -r name size model; do
    [ "$name" = "$BOOT_DISK" ] && continue
    case "$name" in loop*|sr*|fd*|ram*|zram*) continue ;; esac
    printf '%s\t%s\t%s\n' "$name" "$size" "${model:-unknown}"
  done
}

pick_disk() {
  local list n
  list="$(candidates)"
  [ -n "$list" ] || die "no disk found to install onto (the USB itself is excluded)"
  n="$(printf '%s\n' "$list" | wc -l | tr -d ' ')"

  bold "Install target"
  printf '%s\n' "$list" | nl -w2 -s') ' | sed 's/^/  /'
  echo
  if [ "$n" = "1" ]; then
    TARGET="/dev/$(printf '%s\n' "$list" | cut -f1)"
    echo "  Only one candidate: $TARGET"
  else
    local choice
    while :; do
      read -r -p "  Which disk? [1-$n] " choice
      case "$choice" in
        ''|*[!0-9]*) ;;
        *) if [ "$choice" -ge 1 ] && [ "$choice" -le "$n" ]; then
             TARGET="/dev/$(printf '%s\n' "$list" | sed -n "${choice}p" | cut -f1)"
             break
           fi ;;
      esac
      echo "  Pick a number between 1 and $n."
    done
  fi
  echo
}

# ------------------------------------------------------------------- questions
ask() {   # ask VAR "prompt"
  local __var="$1" __prompt="$2"
  while :; do
    # Indirect assignment: read into the variable NAMED by $__var. Verified to
    # work; shellcheck flags it because it is usually a typo.
    # shellcheck disable=SC2229
    read -r -p "  $__prompt: " "$__var"
    [ -n "${!__var}" ] && break
    echo "  This one cannot be empty."
  done
}

ask_pass() {   # ask_pass VAR "prompt"
  local __var="$1" __prompt="$2" a b
  while :; do
    read -r -s -p "  $__prompt: " a; echo
    if [ ${#a} -lt 8 ]; then echo "  At least 8 characters, please."; continue; fi
    # These values travel through station.conf, then .env, then compose
    # interpolation, then a shell command inside a container. Rather than try to
    # escape correctly at four layers, refuse the characters that are hazardous
    # at any of them. (Review #2, #3.)
    if ! printf '%s' "$a" | grep -qE '^[A-Za-z0-9._@%+:~/-]+$'; then
      echo "  Use letters, digits and . _ @ % + : ~ / - only."
      echo "  (spaces, quotes, \$ and backticks break one of the layers this"
      echo "   password passes through)"
      continue
    fi
    read -r -s -p "  $__prompt (again): " b; echo
    [ "$a" = "$b" ] && break
    echo "  They did not match."
  done
  eval "$__var=\$a"
}

questions() {
  if [ -r "$SEED" ]; then
    grn "  Using answers from $SEED (unattended install)"
    UNATTENDED=1
    # shellcheck disable=SC1090
    . "$SEED"
    local missing=""
    for v in STATION_NAME CENTROID_PASSWORD ROOT_PASSWORD VNC_PASSWORD DB_PASSWORD; do
      [ -n "${!v}" ] || missing="$missing $v"
    done
    [ -z "$missing" ] || die "$SEED is missing:$missing"
    for v in DB_PASSWORD VNC_PASSWORD ROOT_PASSWORD CENTROID_PASSWORD; do
      printf '%s' "${!v}" | grep -qE '^[A-Za-z0-9._@%+:~/-]+$' \
        || die "$SEED: $v contains a character that will not survive the shell/compose path"
    done
    return
  fi
  bold "Station settings"
  echo "  These are the only things this installer cannot work out for itself."
  echo
  ask      STATION_NAME       "Station name (shown in the browser tab)"
  ask_pass CENTROID_PASSWORD  "Password for the 'centroid' login"
  ask_pass ROOT_PASSWORD      "Password for 'root'"
  ask_pass VNC_PASSWORD       "Password for the VNC/remote screen"
  ask_pass DB_PASSWORD        "Password for the database"
  echo
}

# ----------------------------------------------------------------------- write
confirm() {
  local answer
  if [ "$UNATTENDED" = 1 ]; then
    red "  UNATTENDED: erasing $TARGET in 15 seconds. Ctrl-C to stop."
    sleep 15
    return
  fi
  red "  ****************************************************"
  red "  *  EVERYTHING ON $TARGET WILL BE ERASED"
  red "  ****************************************************"
  echo
  lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT "$TARGET" | sed 's/^/  /'
  echo
  read -r -p "  Type 'yes' to install, anything else to abort: " answer
  [ "$answer" = "yes" ] || die "aborted at the confirmation prompt"
}

flash() {
  local img bmap imgs
  # centroidx-* not *.img.gz, and exactly one: two images on the key would mean
  # flashing the alphabetically-first while image-info describes the other.
  mapfile -t imgs < <(find "$PAYLOAD" -maxdepth 1 -name 'centroidx-*.img.gz' | sort)
  [ "${#imgs[@]}" = 1 ] \
    || die "expected exactly one centroidx-*.img.gz in $PAYLOAD, found ${#imgs[@]}"
  img="${imgs[0]}"
  bmap="${img%.img.gz}.img.bmap"
  bold "Writing $(basename "$img") to $TARGET"
  if [ -r "$bmap" ]; then
    bmaptool copy --bmap "$bmap" "$img" "$TARGET" || die "bmaptool copy failed"
  else
    echo "  (no .bmap alongside the image; falling back to a full copy)"
    bmaptool copy --nobmap "$img" "$TARGET" || die "bmaptool copy failed"
  fi
  sync
  # Re-read the table so the new partitions appear as devices. NOT swallowed: on
  # EBUSY the kernel keeps the old table, and because bmaptool leaves unmapped
  # blocks untouched a stale superblock can then mount -- which would put
  # station.conf and a journal replay inside the wrong filesystem.
  partprobe "$TARGET" || die "the kernel would not re-read the partition table on $TARGET (is something holding it open?)"
  udevadm settle
}

seed_station_conf() {
  local root
  # By PARTLABEL, not by index: image.yaml sets partlabel: root, and an index
  # would silently pick whatever partition 2 happens to be if the table the
  # kernel holds is not the one we just wrote.
  root="$(lsblk -pno NAME,PARTLABEL "$TARGET" | awk '$2=="root"{print $1; exit}')"
  [ -n "$root" ] || die "no partition labelled 'root' on $TARGET after flashing"
  mkdir -p "$TARGET_MNT"
  mount "$root" "$TARGET_MNT" || die "cannot mount $root"
  mkdir -p "$TARGET_MNT/etc/centroid"
  {
    echo "# Written by the CentroidX installer on $(date -Is)."
    echo "# centroidx-firstboot PARSES this as key=value -- it does not source it."
    echo "# Values are restricted to [A-Za-z0-9._@%+:~/-] at the prompt, so they"
    echo "# survive this file, .env, compose interpolation and a container shell."
    printf 'STATION_NAME=%s\n'      "$STATION_NAME"
    printf 'ROOT_PASSWORD=%s\n'     "$ROOT_PASSWORD"
    printf 'CENTROID_PASSWORD=%s\n' "$CENTROID_PASSWORD"
    printf 'VNC_PASSWORD=%s\n'      "$VNC_PASSWORD"
    printf 'DB_PASSWORD=%s\n'       "$DB_PASSWORD"
  } > "$TARGET_MNT/etc/centroid/station.conf"
  chmod 0600 "$TARGET_MNT/etc/centroid/station.conf"
  echo "${STATION_NAME}" > "$TARGET_MNT/etc/hostname"

  # Remote access is per-station: wg0.conf carries this machine's private key
  # and wg-obfuscator.conf the endpoint and shared obfuscation key, so neither
  # can be baked into an image every station shares. Drop them next to the
  # payload on the USB and they are installed here. (Review #8.)
  install -d -m 0700 "$TARGET_MNT/etc/wireguard"
  if [ -r "$PAYLOAD/wg0.conf" ]; then
    install -m 0600 "$PAYLOAD/wg0.conf" "$TARGET_MNT/etc/wireguard/wg0.conf"
    grn "  installed wg0.conf"
  else
    red "  NOTE: no wg0.conf on the USB - this station will have no VPN access."
    red "        Put one at /etc/wireguard/wg0.conf and: systemctl enable --now wg-quick@wg0"
  fi
  if [ -r "$PAYLOAD/wg-obfuscator.conf" ]; then
    install -m 0600 "$PAYLOAD/wg-obfuscator.conf" "$TARGET_MNT/etc/wg-obfuscator.conf"
    grn "  installed wg-obfuscator.conf"
  fi
  sync
  umount "$TARGET_MNT" || die "cannot unmount $root"
}

# ------------------------------------------------------------------------ main
banner

# Before anything else, and at top level so a failure here actually stops the
# script. A slow-probing NVMe may not be in lsblk yet when the unit starts.
udevadm settle
BOOT_DISK="$(boot_disk)"
[ -n "$BOOT_DISK" ] || die "cannot identify the disk this installer booted from - refusing to offer any target"

pick_disk
questions
confirm
flash
seed_station_conf

rule
grn "  Installed."
echo
bold "  Remove the USB key now."
echo "  Rebooting in 30 seconds. First boot grows the filesystem to the disk,"
echo "  generates this machine's keys, and starts the containers."
rule
sleep 30
reboot
